# Copy this file to .env and set your own values.

# SQLite file path (Prisma resolves a relative path against prisma/schema.prisma's
# directory, not your cwd - prisma/dev.db is the usual choice).
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions. Generate your own; never commit it.
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic API key for the /assistant page (Manager+ only). Get one at
# console.anthropic.com. Leave unset and the assistant returns a clear "not
# set up yet" error instead of failing - the rest of the app is unaffected.
ANTHROPIC_API_KEY=""
