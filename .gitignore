node_modules
.next
.env
.env.*
# SEC-007: any other .env.* (a held-aside or copied env) is never versioned; the example is
!.env.example
*.log
.DS_Store
*.tsbuildinfo

# Real business data - never version this (contains client/job details), and it
# doesn't need to be: `npx prisma db push` rebuilds the schema from prisma/schema.prisma.
prisma/*.db
prisma/*.db-journal

# Claude Code session-local runtime state (e.g. the scheduled-loop lock file) -
# tied to a machine/session, meaningless in git history.
.claude/scheduled_tasks.lock

# Per-machine Claude Code permissions (e.g. the GitHub push rule Ilies added 24 Oct 2026)
.claude/settings.local.json

# Release check (scripts/release-check): its reports and anything a run leaves if it is killed part-way.
# Reports hold check results only (no data), but stay local; the test copy and its .env are never versioned.
release-check-reports/
prisma/rc-probe-search.db
