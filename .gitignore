# Real business data - never version this (contains client/job details), and it
# doesn't need to be: `npx prisma db push` rebuilds the schema from prisma/schema.prisma.
prisma/*.db
prisma/*.db-journal

# Claude Code session-local runtime state (e.g. the scheduled-loop lock file) -
# tied to a machine/session, meaningless in git history.
.claude/scheduled_tasks.lock

# Per-machine Claude Code permissions (e.g. the GitHub push rule Ilies added 24 Oct 2026)
.claude/settings.local.json
