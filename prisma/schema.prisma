// Job board data model
// - Project: a long-running site/job (Projects page)
// - Job: one project's plan for a given date + shift (a row on the Command Centre)
// - Resource: register item. type = PERSONNEL | EQUIPMENT (plant) | ATTACHMENT | VEHICLE | HIRE
// - Assignment: a resource placed on a job (join table) with a per-job role
// - Tool: small-tool register (tagged tools that get held by people / sites)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String // the job/site name, kept separate from who it's for - see `client`
  client    String? // who the work is for, e.g. "CD Constructions"
  jobNo     String? // the SharePoint project folder number, e.g. 26_171 - the job number every Lobos app uses (Ilies, 24 Oct 2026)
  quoteNo   String? // the quote / estimate number the job was won from, e.g. 26_255 - links an estimate to its job
  address   String?
  status    String   @default("ACTIVE") // ACTIVE | STAND_DOWN | ON_HOLD
  startDate String? // YYYY-MM-DD, the first day on site (D12-1, 19 Oct 2026). Before any job exists it is the expected first day; once jobs exist it should equal the first running job date - a mismatch shows as a date exception.
  // How firm the planned dates are (brief 12, 19 Oct 2026): CONFIRMED | TENTATIVE.
  // Their source (document and revision) lives in fieldSources like other
  // Project File fields. Blank means nobody has said.
  startDateConfidence  String?
  completionConfidence String?
  completionReviewBy   String? // YYYY-MM-DD - when a TBC completion should be looked at again
  dayStart  String? // e.g. "7am"
  dayEnd    String?
  nightStart String?
  nightEnd  String?
  // Unpaid meal break deducted from gross shift hours before costing labour
  // (D1, 2026-09-28) - defaults to 30 min but adjustable per project in case a
  // site's award/agreement differs. Applied to live costing only; never
  // rewrites the historical LabourCost backfill.
  unpaidBreakMinutes Int? @default(30)
  notes     String?
  // The room-by-room/task-by-task demolition scope, kept deliberately separate
  // from `notes` (a mixed research scratchpad that sometimes carries $ figures)
  // and `contractValueNotes` (explicitly $-bearing) - this field is the one
  // source the scope-of-works PDF reads from, so it must never contain money.
  // Null means no fixed scope document exists (e.g. a day-rate/as-instructed
  // arrangement) rather than "not yet researched."
  scopeOfWorks String?
  // Agreed job value ex GST, from the signed quote/contract - the "budget"
  // side of budget-vs-actual. Null when the job is do-and-charge/schedule-of-
  // rates (no single value to compare against) or simply not yet researched -
  // contractValueNotes records which, and cites the source, so a null is
  // never mistaken for "confirmed to be zero."
  contractValue      Float?
  contractValueNotes String?

  // Project File (brief 11, Phase 1, 2026-10-14). Every field below is
  // optional with no default: blank means "not known yet", never "none".
  // The Site/Scope fields can go out to crew and clients, so the money guard
  // (lib/moneyGuard.ts) runs on them when saved - see lib/projectFile.ts.
  expectedCompletion String? // YYYY-MM-DD, same format as startDate
  // Lobos office contact - a Personnel-register entry with role "Office",
  // linked rather than retyped. The current supervisor is NOT stored here: it
  // is read from the latest allocation (see lib/projectFile.ts).
  officeContactId    String?
  officeContact      Resource? @relation("ProjectOfficeContact", fields: [officeContactId], references: [id], onDelete: SetNull)
  siteEntry          String? // entry point / gate
  siteParking        String?
  inductionBy        String? // who runs the induction
  inductionBooking   String? // how to book it
  siteLoadingAccess  String? // loading and truck access
  siteRestrictions   String? // noise / dust restrictions
  siteAmenities      String?
  emergencyAssembly  String? // emergency assembly point
  nearestHospital    String?
  sitePpe            String? // task-specific PPE beyond the standard kit
  scopeExclusions    String? // goes with scopeOfWorks above
  // Optional source note per field above (document and revision), stored as
  // JSON text: {"siteParking": "Induction pack Rev B"}.
  fieldSources       String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  invoicedCosts InvoicedCost[]
  hireItems     Resource[] @relation("HireProject")
  siteRequests  SiteRequest[]
  labourCosts   LabourCost[]
  allocationCosts AllocationCost[]
  contacts  ProjectContact[]

  @@index([officeContactId])
}

// External people on a project (client, builder, consultants). Lobos staff
// are never retyped here - they come from the Personnel register. visibleTo
// controls who a contact can be shared with; it starts as INTERNAL so a
// contact only reaches crew or the client when someone deliberately says so.
model ProjectContact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  role      String?
  phone     String?
  email     String?
  visibleTo String   @default("INTERNAL") // CREW | CLIENT | INTERNAL
  source    String? // document and revision this came from
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A real invoiced cost that doesn't fit the Job/Resource/dailyRateExGst model
// (that one assumes a flat $/day for a piece of plant or a hired vehicle -
// this is for variable-cost invoices, e.g. an agency labour-hire bill that's
// a different $ amount every week). Project Tracking shows these as their own
// line per project, separate from the Plant/Attachments/Trucks/Hire cost
// codes that come from assignments.
model InvoicedCost {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor      String // e.g. "Munster Services (Advanced Group)"
  category    String   @default("LABOUR_HIRE") // room to add other invoiced cost types later
  invoiceNo   String?
  weekEnding  String // YYYY-MM-DD - the invoice's own dated week-ending
  dueDate     String? // YYYY-MM-DD
  shift       String? // DAY | NIGHT - null when an invoice doesn't split by shift
  amountExGst Float
  gst         Float
  totalIncGst Float
  notes       String?
  createdAt   DateTime @default(now())
  // Plant hire (24 Oct 2026): the hire-register item this invoice bills and
  // the days it covers. Tracking stops estimating those days for that item,
  // so the real invoice replaces the estimate instead of adding to it.
  hireResourceId String?
  periodFrom     String? // YYYY-MM-DD
  periodTo       String? // YYYY-MM-DD
  enteredBy      String? // who added / last corrected it on Tracking (null = imported)

  @@index([projectId])
  @@index([hireResourceId])
  @@index([invoiceNo])
}

// Invoices inbox (24 Oct 2026): accounts upload supplier invoices (PDF or
// photo) or their invoice register spreadsheet. Claude reads each file into
// InvoiceDrafts; plain code then decides (lib/invoiceInbox.ts): a clear match
// to a job goes straight onto it as an InvoicedCost, anything unclear waits
// for a person. Files live outside the app (INVOICE_FILE_DIR).
model InvoiceUpload {
  id           String   @id @default(cuid())
  fileName     String // stored name, made by lib/invoiceFiles.ts
  originalName String
  kind         String // PDF | IMAGE | SHEET
  status       String   @default("READING") // READING | DONE | FAILED
  error        String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  finishedAt   DateTime?
  drafts       InvoiceDraft[]

  @@index([createdAt])
}

// One invoice found in an upload (a sheet row, or an invoice in a PDF).
model InvoiceDraft {
  id             String   @id @default(cuid())
  uploadId       String
  upload         InvoiceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  rowNo          Int? // sheet row, for finding it again
  supplier       String?
  entityBilled   String?
  invoiceNo      String?
  invoiceDate    String? // YYYY-MM-DD
  periodFrom     String? // YYYY-MM-DD
  periodTo       String?
  description    String?
  siteText       String? // the site as written on the invoice / sheet
  hireRef        String? // supplier's contract / hire number
  amountExGst    Float?
  gst            Float?
  totalIncGst    Float?
  category       String? // PLANT_HIRE | LABOUR_HIRE | TIP_FEES | MATERIALS | OTHER
  projectId      String? // suggested or chosen job
  hireResourceId String? // hire-register item it bills, when known
  confidence     String? // HIGH | LOW - how sure the job match is
  matchReason    String?
  // ADDED (on a job) | NEEDS_REVIEW (a person decides) | NO_JOB (no job in
  // Operations matches) | DUPLICATE (already entered) | SKIPPED (not counted)
  status         String   @default("NEEDS_REVIEW")
  problem        String? // why it needs a person, or why it was skipped
  invoicedCostId String? // the Tracking row it became
  autoAdded      Boolean  @default(false)
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([uploadId])
  @@index([status])
}

// "This is how accounts write that site" -> job. Saved whenever a person
// matches an invoice to a job, so the next upload matches it straight away.
model SiteAlias {
  id        String   @id @default(cuid())
  text      String   @unique // normalised (lower case, single spaces)
  projectId String
  createdBy String?
  createdAt DateTime @default(now())
}

// Own-crew labour cost, backfilled from the daily allocation sheets (issued
// separately from Command Centre and not always reflected in Job/Assignment
// for historical dates). Kept as its own ledger for the same reason as
// InvoicedCost - hours x a person's pay rate is a different shape of cost
// to a flat dailyRateExGst, and real Jobs already exist for some of these
// dates so writing into Job/Assignment risks duplicating them.
model LabourCost {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resourceId  String?
  resource    Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  personName  String // snapshot at import time - survives resourceId being null (unresolved person) or a later rename
  date        String // YYYY-MM-DD, the allocation's real work-date (from the sheet's own header, not the filename)
  shift       String // DAY | NIGHT
  hours       Float? // null when the source sheet gave no parseable end time
  rateTier    String? // ORDINARY | NIGHT | SATURDAY | SUNDAY - which of the resource's rates was applied
  rateUsed    Float? // the $/hr actually applied; null when the rate is still TBC
  cost        Float? // hours * rateUsed; null when rateUsed is null
  source      String    @default("allocation-pdf") // where this row came from
  notes       String? // e.g. "identified from sheet as 'John' - uncertain match"
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([resourceId])
  @@index([date])
}

model Job {
  id          String       @id @default(cuid())
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String // e.g. "Myers - Streetbuild"
  client      String? // who the work is for (may differ from the project/site name)
  siteCode    String? // job number e.g. "007"
  siteAddress String?
  date        DateTime
  shift       String       @default("DAY") // DAY | NIGHT
  startTime   String? // free text e.g. "8:30am"
  endTime     String? // free text e.g. "3pm"
  status      String       @default("ACTIVE") // INACTIVE | ACTIVE | STOOD_DOWN | COMPLETED
  dayBrief    String? // instructions text for the day / scope of works
  // Why this job was saved despite a date warning (before the project start,
  // after planned completion, on an inactive project, weekend) - brief 12.
  // Internal only; never shown to crew.
  dateCheckNote String?
  colorTag    String       @default("blue") // left border color on the board
  notRunning  Boolean      @default(false) // derived from status = INACTIVE/STOOD_DOWN; drives the "not active" grouping. COMPLETED jobs are excluded from the board entirely (see /completed).
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  allocationCosts AllocationCost[]
  jobActuals  JobActual[]
  attendances SiteAttendance[]

  // A project has at most one Job per date+shift - this is the invariant the
  // Command Centre board relies on (one row per project per day). SQLite
  // treats NULL as distinct from any other value in a unique index, so
  // projectId-less ad-hoc jobs are untouched by this and can still repeat
  // freely. Added 2026-10-10 after a real duplicate-job bug: completed jobs
  // are hidden from the board for their date (by design - see notRunning
  // above), which left the board showing an empty placeholder for a project
  // that already had a completed job that day, inviting a second one to be
  // created on top of it. POST /api/jobs now checks for this up front with a
  // clear error; this constraint is the backstop that makes it impossible
  // regardless of which code path creates the job.
  @@unique([projectId, date, shift])
  @@index([date])
  @@index([projectId])
}

model Resource {
  id          String       @id @default(cuid())
  toolboxes   Toolbox[] // toolboxes this person is in charge of
  siteLinks   SiteLink[] // their private site-photo link(s)
  attendances SiteAttendance[] // site sign-ins / sign-outs
  name        String
  type        String // PERSONNEL | EQUIPMENT | ATTACHMENT | VEHICLE | HIRE
  category    String? // register section: Site Manager / Tipper / PLANT|LABOUR|VEHICLE (hire) ...
  role        String? // default role for assignments (Supervisor, Operator, ...)
  identifier  String? // rego / asset tag
  status      String       @default("AVAILABLE") // AVAILABLE | ON_SITE | DOWN | LEAVE
  detail      String? // attachments: "suits 5.5t Excavator"; plant: free detail
  serviceDue  String?
  loadSize    String?
  ownership   String       @default("OWNED") // OWNED | HIRED
  payClass    String?
  phone       String?
  email       String?
  tickets     String?
  notes       String?
  agency      String? // hire
  hireStart   String? // hire - legacy free text, kept read-only until re-entered as onHireDate
  hireEnd     String? // hire expected finish - legacy free text, kept read-only until re-entered as offHireDate
  // Typed on/off-hire dates (Phase 2b, 2026-09-28) - replace hireStart/
  // hireEnd's free text ("22 Sept") once re-entered here; idle-hire and the
  // overdue check prefer these when set, falling back to the legacy free
  // text (best-effort parsed) until they are.
  onHireDate  String? // YYYY-MM-DD
  offHireDate String? // YYYY-MM-DD, expected finish
  rate        String? // hire - legacy free text, kept read-only until re-entered as hireRate/hireRateUnit
  dailyRateExGst Float? // cost code: $/day (ex GST) while allocated to a job
  // Numeric hire rate (D3, Phase 2, 2026-09-28) - lets hired labour/plant/
  // vehicles be costed live per allocation the same way owned plant is,
  // instead of only via the legacy free-text `rate`. Deliberately separate
  // from `rate`/hireStart/hireEnd, which stay untouched until re-entered here.
  hireRate     Float?
  hireRateUnit String? // HOUR | DAY | WEEK
  // Hire register (21 Oct 2026): what a hired item is for and roughly what
  // it costs. hireProjectId set = the item is costed as an estimate for
  // every working day it's on hire (lib/hireEstimate.ts), not per board day.
  // Estimates only - supplier invoices aren't matched yet (Xero later).
  hireProjectId      String?
  hireProject        Project? @relation("HireProject", fields: [hireProjectId], references: [id], onDelete: SetNull)
  hireRef            String? // supplier's hire / docket / order number
  hireDeliveryCost   Float? // one-off delivery charge, ex GST
  hireCollectionCost Float? // one-off pick-up charge, ex GST
  hireStatus         String? // BOOKED | ON_HIRE | OFF_HIRE_REQUESTED | RETURNED
  hireSource         String? // where it came from, e.g. "Email: Hire Express, 16 Oct 2026, 'Confirmation email'"

  // Pay rate (personnel only) - what Lobos actually pays this person. Kept
  // separate from dailyRateExGst (that's for plant/vehicles/hire, never set
  // on a person). Structure mirrors the "Lobos Pay Rates" working-draft
  // spreadsheet: most people are on an hourly ordinary rate with optional
  // loadings; a few staff are salaried instead; a few historical/invoiced
  // arrangements are a flat day rate. payRateConfirmed=false means the figure
  // is a TBC/draft value pending confirmation, not settled payroll.
  payRateBasis      String? // HOURLY | SALARY | DAY_RATE - which fields below apply
  annualSalary      Float? // for basis = SALARY
  ordinaryRate      Float? // hourly ordinary rate, or the amount if basis = DAY_RATE
  nightRate         Float?
  travelRate        Float? // "Driving/Tools/Tipping/Travel" loading
  regionalDayRate   Float? // "Out of Sydney" / regional, day
  regionalNightRate Float? // "Out of Sydney" / regional, night
  saturdayRate      Float?
  sundayRate        Float?
  payRateConfirmed  Boolean  @default(false) // false = TBC, not yet confirmed
  payRateNotes      String? // source, discrepancies, caveats

  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  serviceRecords ServiceRecord[]
  labourCosts LabourCost[]
  allocationCosts AllocationCost[]
  jobActuals  JobActual[]
  officeContactFor Project[] @relation("ProjectOfficeContact")

  @@index([type])
}

// One service/repair visit for a vehicle (or any resource), oldest to newest.
model ServiceRecord {
  id          String   @id @default(cuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  mechanic    String?
  invoiceNo   String?
  work        String? // work performed
  amountExGst Float?
  gst         Float?
  total       Float?
  odometer    Int? // km at time of service, if known
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resourceId])
  @@index([date])
}

model Assignment {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  role       String? // role for this specific job (defaults to resource.role, editable)
  createdAt  DateTime @default(now())

  @@unique([jobId, resourceId])
  @@index([jobId])
  @@index([resourceId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lower-case
  name         String
  passwordHash String // scrypt$<salt>$<hash>
  role         String    @default("VIEWER") // ADMIN | MANAGER | VIEWER | TIMESHEETS | ACCOUNTS
  active       Boolean   @default(true)
  // Director Insights (24 Oct 2026): sees /directors - the company overview.
  // Separate from role so a future Admin doesn't see it by default. Only the
  // owner (lib/owner.ts) can tick or untick it; the owner always has it.
  directorAccess Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  pushDevices  PushDevice[]
}

// A phone/browser that gets notifications (Web Push, 21 Oct 2026) - site
// requests alert Ilies's phone. The endpoint + keys come from the browser;
// sending goes through the browser maker's push service (Google for Android).
model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String? // e.g. "Android - Chrome"
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
  failures   Int       @default(0) // consecutive failed sends; removed when the push service says it's gone

  @@index([userId])
}

model BugReport {
  id          String   @id @default(cuid())
  title       String
  description String
  page        String? // path it was reported from, e.g. /command
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | FIXED | WONT_FIX
  reportedBy  String? // name + email snapshot, so it survives the user being removed later
  userAgent   String?
  notes       String? // resolution notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per costed allocation on a given date - the permanent, frozen
// record a day-close (Phase 3/D2) leaves behind, so a closed date's cost
// stops moving even as pay rates or hire rates change later. Wholesale
// replaced (delete + recreate for the date) each time that date is closed,
// so closing again after a correction never leaves stale rows behind. Not
// written for open dates - those still cost live, the same way Tracking
// always has. assignmentId is a plain snapshot (no FK): the Assignment row
// itself can later be deleted (e.g. after a re-open) without touching this
// historical record.
model AllocationCost {
  id           String    @id @default(cuid())
  assignmentId String
  jobId        String?
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resourceId   String?
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  costType     String // LABOUR | HIRE_LABOUR | PLANT | ATTACHMENT | VEHICLE | HIRE
  amount       Float?
  status       String? // CostStatus at freeze time - never silently $0
  createdAt    DateTime  @default(now())

  @@index([projectId])
  @@index([date])
}

// Whether a calendar date's allocations are locked against further edits
// (D2, 2026-09-28). Close: Manager+. Re-open: Admin only, with a reason -
// so unlocking a closed day always leaves an audit trail, never a silent
// edit. No row for a date means it's open (the default).
model DayClose {
  id           String    @id @default(cuid())
  date         String    @unique // YYYY-MM-DD
  status       String    @default("OPEN") // OPEN | CLOSED
  closedBy     String?
  closedAt     DateTime?
  reopenedBy   String?
  reopenedAt   DateTime?
  reopenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A site supervisor's actual record for one resource on one job/day (Phase
// 4, Day Review) - separate from Assignment (the plan) so "who was actually
// there, for how long" can differ from "who was rostered on" without
// touching the roster itself. A row with no matching Assignment is an
// unplanned addition: someone/something on site that wasn't in the plan.
model JobActual {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  attended    Boolean  @default(true)
  actualHours Float?
  // "SIGN_IN" when filled from site sign-ins (21 Oct 2026) - follows later
  // sign-in corrections; null when someone typed it (never overwritten).
  hoursSource String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jobId, resourceId])
  @@index([jobId])
}

model Tool {
  id        String   @id @default(cuid())
  tag       String   @unique // LOB-0001 - also printed on the tool's QR label
  name      String // what it is, e.g. "Hammer drill driver"
  model     String? // model (older rows may still hold "model · serial" from before serialNumber existed)
  condition String   @default("Good") // New | Good | Needs repair | Missing
  heldBy    String   @default("Yard") // who has it - kept in step with the toolbox's supervisor when it has a home toolbox
  lastSeen  String?
  notes     String?
  // Tool register by photo (19 Oct 2026). Read from the rating plate photo
  // and confirmed by a person before saving - never saved straight from AI.
  brand          String?
  serialNumber   String? // from the rating plate, e.g. Hilti "Serial no."
  // serialNumber with spaces/dashes/dots dropped and upper-cased - unique, so
  // the same tool can never be registered twice (19 Oct 2026). Null when no
  // serial is recorded.
  serialKey      String?  @unique
  // Set when the rating plate can't be read (worn, painted over, missing) - a
  // new tool needs a serial OR this. These have their own category.
  plateUnreadable Boolean @default(false)
  // Where the tool was added from: OFFICE (this app), OFFICE_LINK (office /
  // yard person's phone link) or SITE (a supervisor's link). SITE tools go
  // straight into the inventory with needsCheck set until the office looks.
  addedFrom      String?
  addedBy        String?
  needsCheck     Boolean  @default(false)
  itemNo         String? // manufacturer item / part number, e.g. Hilti FFE
  manufactured   String? // as printed, e.g. "06/2026"
  conditionNotes String? // damage / wear seen on the condition photo
  ownership      String   @default("OWNED") // OWNED | HILTI_FLEET | HIRED
  fleetRef       String? // Hilti fleet / contract reference when on fleet
  // The toolbox this tool should live in. Null = in the yard / unassigned.
  toolboxId String?
  toolbox   Toolbox? @relation(fields: [toolboxId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    ToolPhoto[]
  movements ToolMovement[]
  issues    ToolIssue[] @relation("issueTool")
  replacedIssues ToolIssue[] @relation("replacementTool")

  @@index([serialNumber])
  @@index([toolboxId])
}

// A supervisor's digital toolbox: the tools (by serial / LOB tag) they should have.
model Toolbox {
  id           String    @id @default(cuid())
  name         String // e.g. "Sinan's toolbox"
  supervisorId String? // Personnel-register entry in charge of it
  supervisor   Resource? @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tools        Tool[]
  checks       ToolboxCheck[]
}

// Photos kept for a tool: the rating plate, its condition, a fault, or a
// toolbox-check photo. Files live outside the app folder (TOOL_PHOTO_DIR).
model ToolPhoto {
  id        String   @id @default(cuid())
  toolId    String? // null while uploaded but not yet attached (e.g. mid-registration or a toolbox check)
  tool      Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  kind      String // PLATE | CONDITION | FAULT | CHECK
  fileName  String // file inside TOOL_PHOTO_DIR
  siteLinkId String? // set when uploaded from site through a supervisor's link
  takenBy   String?
  createdAt DateTime @default(now())

  @@index([toolId])
}

// Every change of a tool's home toolbox - who moved it, when and why.
model ToolMovement {
  id            String   @id @default(cuid())
  toolId        String
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  fromToolboxId String?
  toToolboxId   String?
  fromName      String? // snapshot of the toolbox names, survives a rename
  toName        String?
  reason        String?
  movedBy       String?
  createdAt     DateTime @default(now())

  @@index([toolId])
}

// A photo check of a toolbox against what should be in it. found/missing/
// foreign/unknown are worked out in code from what the photo shows.
model ToolboxCheck {
  id        String   @id @default(cuid())
  toolboxId String
  toolbox   Toolbox  @relation(fields: [toolboxId], references: [id], onDelete: Cascade)
  photoIds  String // JSON array of ToolPhoto ids
  result    String // JSON: { present, presentUnconfirmed, missing, foreign, unknown }
  checkedBy String?
  createdAt DateTime @default(now())

  @@index([toolboxId])
}

// A fault reported on a tool, e.g. "not hammering properly". Fleet tools get
// swapped out with Hilti: REPORTED -> SWAP_REQUESTED -> SWAPPED, or FIXED /
// CLOSED. Operations never contacts Hilti itself.
model ToolIssue {
  id                String    @id @default(cuid())
  toolId            String
  tool              Tool      @relation("issueTool", fields: [toolId], references: [id], onDelete: Cascade)
  description       String
  status            String    @default("REPORTED") // REPORTED | SWAP_REQUESTED | SWAPPED | FIXED | CLOSED
  photoId           String?
  reportedBy        String?
  swapRef           String? // Hilti swap / repair job number once requested
  replacementToolId String?
  replacementTool   Tool?     @relation("replacementTool", fields: [replacementToolId], references: [id], onDelete: SetNull)
  resolution        String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([toolId])
  @@index([status])
}

// A supervisor's private link to the Site photos page (19 Oct 2026). The page
// is the only part of Operations reachable from outside (through the tunnel)
// and it can only upload photos. Only a hash of the link's secret is stored -
// the full link is shown once when made; a lost link is replaced, not resent.
model SiteLink {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha256 of the secret in the link
  // The Personnel-register person it belongs to - or none, for a shared
  // link known by its label (e.g. "Yard": anyone working in the yard).
  resourceId String?
  label      String?
  // SUPERVISOR: their own toolbox (register, check, fault) and running crew
  // sign-in on their jobs. OFFICE: office / yard staff capturing tools into
  // the inventory (any toolbox or the yard). HANDOVER: a one-day link for a
  // stand-in lead to run sign-in on one job (jobId, expiresAt). POSTER: the
  // fixed QR on a site's poster (projectId) - crew scan it to sign in. A
  // POSTER with `place` is a fixed sign-in point instead of a site (20 Oct
  // 2026): OFFICE, YARD, or VEHICLE (resourceId = the Lobos-owned truck).
  kind       String    @default("SUPERVISOR")
  projectId  String? // POSTER (site)
  place      String? // POSTER (sign-in point): OFFICE | YARD | VEHICLE
  jobId      String? // HANDOVER
  expiresAt  DateTime? // HANDOVER - stops working at the end of that day
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime? // set = switched off; the link stops working
  submissions SiteSubmission[]
  pushDevices SiteLinkPushDevice[]
}

// A supervisor's phone that gets alerts through their site link (24 Oct
// 2026) - e.g. "4 still signed in, shift finishes in 20 minutes". Same Web
// Push as the office (lib/push.ts), tied to the link, not a login.
model SiteLinkPushDevice {
  id         String    @id @default(cuid())
  siteLinkId String
  siteLink   SiteLink  @relation(fields: [siteLinkId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
  failures   Int       @default(0)

  @@index([siteLinkId])
}

// One row per job per kind of automatic reminder, so each goes out once
// (24 Oct 2026). kind SIGNOUT_20 = supervisors, 20 min before the finish.
model ShiftReminder {
  id     String   @id @default(cuid())
  jobId  String
  kind   String
  sentAt DateTime @default(now())
  people Int      @default(0) // how many were still signed in

  @@unique([jobId, kind])
}

// Something sent from site: a tool to register, a toolbox check, or a fault.
// It waits here until the office applies or rejects it - nothing from site
// changes the register by itself.
model SiteSubmission {
  id          String    @id @default(cuid())
  siteLinkId  String
  siteLink    SiteLink  @relation(fields: [siteLinkId], references: [id], onDelete: Cascade)
  kind        String // REGISTER | CHECK | FAULT
  photoIds    String // JSON array of ToolPhoto ids
  toolId      String? // FAULT: the tool it's about
  toolboxId   String? // CHECK: the toolbox checked
  description String? // FAULT: what's wrong / any note from site
  reading     String? // REGISTER: JSON of what the plate photo read as
  checkId     String? // CHECK: the ToolboxCheck it produced
  status      String    @default("PENDING") // PENDING | APPLIED | REJECTED
  appliedRef  String? // e.g. the tool or fault created from it
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([siteLinkId])
}

// Site sign-in / sign-out (19 Oct 2026). Crew scan the supervisor's QR (it
// changes every 30 seconds, so it proves they were standing there) or the
// site poster's QR. Poster sign-ins wait for the site supervisor to confirm;
// only the office (Manager+) changes a time, and every change is kept in
// AttendanceEdit. Times are stamped by the server, never the phone.
model SiteAttendance {
  id            String    @id @default(cuid())
  // A site sign-in belongs to a job; an office / yard / truck sign-in (20 Oct
  // 2026) has no job and a `place` instead.
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  place         String? // OFFICE | YARD | VEHICLE
  vehicleId     String? // VEHICLE: the truck (a Resource) - not a relation, the name is kept in placeLabel
  placeLabel    String? // e.g. "Office", "Yard", "Tipper - CN03RK"
  date          String // YYYY-MM-DD - the job's date (sign-in points: Sydney's date at sign-in)
  resourceId    String? // a Personnel-register person; null for hire / subcontractor workers
  resource      Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  workerName    String // name as signed in (hire: what they typed)
  company       String? // hire / subcontractor company
  allocated     Boolean   @default(true) // on that job's allocation when they signed in
  deviceId      String? // the phone used - flags one phone signing in several people
  signInAt      DateTime
  signInMethod  String // SUPERVISOR_QR | POSTER | MANUAL (ticked in by the supervisor) | OFFICE
  signOutAt     DateTime?
  signOutMethod String? // SUPERVISOR_QR | POSTER | MANUAL | OFFICE | MOVED (signed in at another site)
  status        String    @default("CONFIRMED") // CONFIRMED | TO_CONFIRM | REJECTED
  confirmedBy   String?
  confirmedAt   DateTime?
  runBy         String? // the supervisor / lead whose QR or link was used
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  edits         AttendanceEdit[]

  @@index([jobId])
  @@index([date])
  @@index([resourceId])
  @@index([place])
}

// Every office change to a sign-in: what, from, to, why, who.
model AttendanceEdit {
  id           String         @id @default(cuid())
  attendanceId String
  attendance   SiteAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  field        String
  before       String?
  after        String?
  reason       String
  editedBy     String
  editedAt     DateTime       @default(now())

  @@index([attendanceId])
}

// Weekly timesheets (21 Oct 2026, Ilies): a Manager approves a week (Monday
// to Sunday) of Lobos staff hours from site sign-ins before it goes to
// accounts. `snapshot` is the JSON of every line exactly as approved - what
// the export sends - so it never changes afterwards, even if a sign-in is
// later corrected. While approved, the office can't change that week's
// sign-ins; an Admin can reopen it with a reason. Rows are never deleted:
// re-approving after a reopen adds a new row, so the history stays.
model TimesheetWeek {
  id           String    @id @default(cuid())
  weekStart    String // YYYY-MM-DD, the Monday
  approvedBy   String
  approvedAt   DateTime  @default(now())
  snapshot     String // JSON: { lines, people } exactly as approved
  totalHours   Float
  people       Int
  reopenedBy   String?
  reopenedAt   DateTime?
  reopenReason String?

  @@index([weekStart])
}

// Site requests (21 Oct 2026, Ilies): supervisors ask for labour, trucks,
// hire, tools and so on from their private link instead of a call or a
// WhatsApp. Only Ilies (ADMIN) decides; approved ones go on the to-do list of
// the person they're assigned to (Alex, on his office link). Every step is
// kept in SiteRequestEvent. Nothing is deleted - a request is declined or
// cancelled instead.
model SiteRequest {
  id            String    @id @default(cuid())
  number        Int       @unique // shown as R-0001
  kind          String // LABOUR | TRUCK | BIN_SWAP | HIRE | TOOLS | MATERIALS | DELIVERY | SAFETY | DOCUMENTS | OTHER | OFF_HIRE
  priority      String // LOW | HIGH | URGENT
  neededBy      DateTime // when it has to be actioned by
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteLabel     String // site name as sent - survives a project rename
  summary       String // one line: what is being asked for
  details       String // JSON of the type's fields (lib/siteRequests.ts)
  note          String? // the supervisor's note
  photoFile     String? // optional photo, inside TOOL_PHOTO_DIR
  requestedBy   String // name as sent
  requestedById String? // Personnel resource, when the link has one
  siteLinkId    String? // the link it came from
  // SENT | SEEN | NEEDS_INFO | TODO (assigned) | MINE (Ilies doing it) | DONE | CANT_DO | DECLINED | CANCELLED
  status        String    @default("SENT")
  seenAt        DateTime?
  officeNote    String? // Ilies's note for whoever actions it
  question      String? // Ilies asking the supervisor for more info
  answer        String? // the supervisor's reply
  declineReason String?
  assigneeId    String? // Personnel resource whose to-do it's on (Alex)
  assigneeName  String?
  outcome       String? // done note ("Booked Hire Express #4471") or why it can't be done
  doneAt        DateTime?
  hireResourceId String? // a hire register item this request is about (off-hire, hire check)
  // Reminders (23 Oct 2026) - Ilies's own nudge so non-urgent requests don't
  // drift. remindedAt = when the phone alert went out for this reminder.
  remindAt      DateTime?
  remindNote    String?
  remindedAt    DateTime?
  // The AI's suggested reminder from reading the thread (JSON: remindAt,
  // note, newNeededBy, reason) - shown for Ilies to accept or dismiss, never
  // applied by itself. aiSuggestedAt = when it last read the thread.
  aiSuggestion  String?
  aiSuggestedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  events        SiteRequestEvent[]

  @@index([status])
  @@index([assigneeId])
  @@index([siteLinkId])
  @@index([remindAt])
}

// Hire check (stage 3, 24 Oct 2026): a supervisor's answer about a hire-
// register item on their site - still needed, finished (call it off), or not
// on site. Finished / not on site / still needed past its finish each raise a
// site request (requestId) so the office decides as usual. Kept as history.
model HireCheck {
  id         String   @id @default(cuid())
  resourceId String // the hire-register item
  projectId  String?
  siteLinkId String
  answer     String // STILL_NEEDED | FINISHED | NOT_ON_SITE
  note       String?
  by         String
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
}

model SiteRequestEvent {
  id        String      @id @default(cuid())
  requestId String
  request   SiteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String // SENT | SEEN | ASKED | ANSWERED | APPROVED | MINE | DECLINED | DONE | CANT_DO | PRIORITY | NEEDED_BY | CANCELLED | REOPENED
  by        String
  note      String?
  at        DateTime    @default(now())

  @@index([requestId])
}

// Director Insights weekly snapshot (24 Oct 2026, Ilies: "start now"). One
// row per KPI per week, written the first time the server checks in a new
// Monday-Sunday week (lib/insights/snapshot.ts), so trends like "jobs at Act"
// or "forecast at the start of the month" can be shown later - live data
// can't rebuild those. Append-only: a week's row is never overwritten or
// deleted, even if the data behind it is corrected later.
model KpiSnapshot {
  id         String   @id @default(cuid())
  weekStart  String // YYYY-MM-DD, the Monday of the week it was taken in
  kpi        String // KPI id from lib/insights/dictionary.ts, e.g. "O1"
  value      Float? // null when it couldn't be worked out
  detail     String? // optional JSON (e.g. counts by status)
  confidence String? // HIGH | MEDIUM | LOW
  createdAt  DateTime @default(now())

  @@unique([weekStart, kpi])
  @@index([kpi])
}

// Findings (Director Insights Phase 2 / LCI phase 3, 24 Oct 2026): one record
// per problem, not per detection run - lib/findings/engine.ts turns the
// computed signals (lib/findings/signals.ts) into these. openKey = dedupeKey
// while the finding is not closed, null once it is: SQLite allows any number
// of NULLs in a unique index, so the database holds at most one open finding
// per problem. Never deleted (Restrict on the history below).
// Design: director-insights-plan/PHASE2-FINDINGS-DESIGN.md.
model Finding {
  id            String    @id @default(cuid())
  ruleCode      String // the signal kind, e.g. COST_VS_CONTRACT, HIRE_OVERDUE, DATE_START_MISMATCH
  subjectType   String // PROJECT | RESOURCE | JOB | COMPANY
  subjectId     String
  subjectName   String // as last seen - the key uses ids, so a rename never splits a finding
  projectId     String?
  dedupeKey     String // kind:subjectType:subjectId[:qualifier]
  openKey       String?   @unique
  severity      String // CRITICAL | HIGH | MEDIUM | INFO
  audience      String // OPERATIONAL (Viewer+, no money) | COMMERCIAL (Manager+) | DIRECTOR
  title         String
  status        String    @default("OPEN") // OPEN | ACKNOWLEDGED | ACTIONED | RESOLVED | DISMISSED | VERIFIED
  provisional   Boolean   @default(false)
  confidence    String? // HIGH | MEDIUM | LOW
  source        String    @default("RULE") // RULE | PERSON
  currentValue  String? // JSON of the latest measured values (history in FindingEvidence)
  href          String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  seenCount     Int       @default(1)
  // Verification "asap" (FINDINGS_CONFIG): when the signal went clear, and
  // how many days it has stayed clear since.
  signalClearedAt     DateTime?
  clearRuns           Int       @default(0)
  resolvedWhileFiring Boolean   @default(false) // a person closed it while still firing: never auto-verified
  ownerUserId   String?
  ownerName     String?
  dueDate       String? // YYYY-MM-DD
  resolvedAt    DateTime?
  resolvedBy    String?
  resolution    String?
  dismissedAt   DateTime?
  dismissedBy   String?
  dismissKind   String? // FALSE_ALARM | ACCEPTED_RISK
  dismissReason String?
  suppressUntil String? // YYYY-MM-DD, ACCEPTED_RISK only
  verifiedAt    DateTime?
  verifiedBy    String? // "System" when verified automatically
  outcomeResult String? // EFFECTIVE | NOT_EFFECTIVE | RECURRED
  outcome       String?
  reopenedFromId String? // a new finding after the recurrence window links to the old one
  createdBy     String    @default("System")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  evidence      FindingEvidence[]
  events        FindingEvent[]

  @@index([dedupeKey])
  @@index([status, severity])
  @@index([projectId])
  @@index([ruleCode])
}

// What a rule saw, from where and when - append-only, never updated or
// deleted. Written when a finding opens and on a material change only.
model FindingEvidence {
  id           String    @id @default(cuid())
  findingId    String
  finding      Finding   @relation(fields: [findingId], references: [id], onDelete: Restrict)
  kind         String // METRIC | RECORD | DOCUMENT | NOTE
  recordType   String? // e.g. Project, Resource, InvoicedCost, SiteRequest
  recordId     String?
  label        String
  value        String? // JSON
  sourceSystem String    @default("Operations")
  asOf         DateTime? // how fresh the source data was
  capturedAt   DateTime  @default(now())
  capturedBy   String    @default("System")

  @@index([findingId])
}

// Every change to a finding, with who and why - append-only.
model FindingEvent {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Restrict)
  // OPENED | ESCALATED | DEESCALATED | ACKNOWLEDGED | ASSIGNED | ACTION_CREATED | QUERY_CREATED | ANSWERED |
  // ACTIONED | RESOLVED | AUTO_RESOLVED | SIGNAL_CLEARED | SIGNAL_RETURNED | NOT_FIXED | DISMISSED | REOPENED |
  // RECURRED | VERIFIED | COMMENT
  action    String
  by        String // a name, or "System"
  byUserId  String?
  fromValue String?
  toValue   String?
  note      String?
  at        DateTime @default(now())

  @@index([findingId])
  @@index([at])
}
